# Frontend Environment Variables
# Copy this file to .env (no .example) and fill in your values

# REQUIRED: Google Maps API Key (for DeliveryMap component)
# Get free key: https://console.cloud.google.com → APIs & Services → Credentials → Create Credentials → API Key
# Enable: Maps JavaScript API + Places API
REACT_APP_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# OPTIONAL: Backend API URL (auto-detects localhost in dev)
# REACT_APP_API_URL=http://localhost:5000/api

# Restart `npm start` after adding .env file